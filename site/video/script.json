{
  "based_on": "9d77c4b",
  "label": "Quill in use: during a video call, the live notes panel ticks off a question and a new one arrives; after the call, the meeting's notes open; the transcript scrolls past a lane for each person, marking who talked over whom, with Priya named by her voice; on the Action items page, an overdue item is ticked off; search finds the hiring discussion when asked \"when did we talk about hiring\", by meaning rather than exact words; in a chat app, holding a key shows live captions of what's said and the text is typed into the message.",
  "viewport": {
    "width": 1000,
    "height": 720,
    "scale": 2
  },
  "output": [
    1600,
    1000
  ],
  "crf": 24,
  "scenes": [
    {
      "id": "live",
      "caption": "Notes while you talk",
      "flags": "live",
      "ready": ".live-panel",
      "setup": [
        {
          "stage": "call"
        },
        {
          "wait": 500
        }
      ],
      "camera": [
        296,
        8,
        696
      ],
      "cursorStart": ".stage-tile.b",
      "steps": [
        {
          "wait": 450
        },
        {
          "click": ".live-section.ask .live-item:first-child .live-tick"
        },
        {
          "wait": 250
        },
        {
          "hover": ".stage-tile.a .stage-face"
        },
        {
          "wait": 700
        },
        {
          "eval": "__stage.talk('Dan')"
        },
        {
          "wait": 500
        },
        {
          "eval": "__stage.note({ id: 'n7', kind: 'ask', text: 'Ask when the pricing experiments restart', who: null, done: false }, 'Now on pricing: the experiments wait for clean analytics.')"
        }
      ],
      "hold": 2100
    },
    {
      "id": "notes",
      "caption": "Full notes when it ends",
      "ready": ".home",
      "camera": ".page",
      "pad": 0,
      "cursorStart": "text:Record",
      "steps": [
        {
          "click": ".latest-title"
        },
        {
          "wait": 500
        },
        {
          "hover": "text:Summary"
        }
      ],
      "hold": 2100
    },
    {
      "id": "transcript",
      "caption": "Knows who said what",
      "ready": ".home",
      "setup": [
        {
          "click": ".latest-title"
        },
        {
          "wait": 500
        },
        {
          "click": "text:Transcript"
        },
        {
          "wait": 500
        }
      ],
      "camera": [
        230,
        266,
        716
      ],
      "cursorStart": ".transcript .line:nth-child(3) .turn-text",
      "steps": [
        {
          "wait": 300
        },
        {
          "cursor": "hide"
        },
        {
          "scroll": ".transcript .line:nth-child(12)"
        },
        {
          "wait": 400
        }
      ],
      "hold": 2000,
      "flags": "voices"
    },
    {
      "id": "actions",
      "caption": "Every to-do in one list",
      "ready": ".home",
      "setup": [
        {
          "click": "text:Action items"
        },
        {
          "wait": 500
        },
        {
          "scroll": ".kind-filter",
          "to": 20
        },
        {
          "wait": 300
        }
      ],
      "camera": ".page",
      "pad": 0,
      "cursorStart": ".kind-filter",
      "steps": [
        {
          "wait": 300
        },
        {
          "click": ".action-row:not(.done) .action-check"
        },
        {
          "wait": 800
        },
        {
          "hover": ".action-row:not(.done) .action-meeting"
        }
      ],
      "hold": 1800
    },
    {
      "id": "search",
      "caption": "Find it by meaning",
      "ready": ".home",
      "setup": [
        {
          "click": "text:Search"
        },
        {
          "wait": 400
        }
      ],
      "camera": ".palette",
      "pad": 16,
      "cursorStart": ".palette-search",
      "steps": [
        {
          "cursor": "hide"
        },
        {
          "type": {
            "into": "input[aria-label=\"Search\"]",
            "text": "when did we talk about hiring",
            "cps": 19
          }
        },
        {
          "wait": 400
        },
        {
          "cursor": "show"
        },
        {
          "hover": ".palette-row-icon"
        }
      ],
      "hold": 1700
    },
    {
      "id": "dictate",
      "caption": "Speak instead of typing",
      "flags": "indicator",
      "ready": ".indicator-stage",
      "setup": [
        {
          "stage": "compose"
        },
        {
          "wait": 400
        }
      ],
      "camera": [
        120,
        40,
        760
      ],
      "cursorStart": ".stage-msg p",
      "steps": [
        {
          "click": ".stage-compose"
        },
        {
          "eval": "__stage.focus()"
        },
        {
          "wait": 350
        },
        {
          "cursor": "hide"
        },
        {
          "eval": "__stage.dictate(\"Sounds good, I'll send the rollout plan to support by Wednesday.\")"
        }
      ],
      "hold": 1500
    }
  ]
}
