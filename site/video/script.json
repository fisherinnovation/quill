{
  "based_on": "8ebfdb2",
  "label": "Quill in use: during a video call, the live notes panel ticks off a question and a new one arrives; after the call, the meeting's notes open; the transcript shows who said what; the Stats tab charts who spoke when; in a chat app, holding a key shows live captions of what's said and the text is typed into the message; the Dictations page counts up words dictated and time saved over a moving waveform.",
  "viewport": {
    "width": 1000,
    "height": 720,
    "scale": 2
  },
  "output": [
    1600,
    1000
  ],
  "crf": 24,
  "scenes": [
    {
      "id": "live",
      "caption": "Notes while you talk",
      "flags": "live",
      "ready": ".live-panel",
      "setup": [
        {
          "stage": "call"
        },
        {
          "wait": 500
        }
      ],
      "camera": [
        296,
        8,
        696
      ],
      "cursorStart": ".stage-tile.b",
      "steps": [
        {
          "wait": 450
        },
        {
          "click": ".live-section.ask .live-item:first-child .live-tick"
        },
        {
          "wait": 250
        },
        {
          "hover": ".stage-tile.a .stage-face"
        },
        {
          "wait": 700
        },
        {
          "eval": "__stage.talk('Dan')"
        },
        {
          "wait": 500
        },
        {
          "eval": "__stage.note({ id: 'n7', kind: 'ask', text: 'Ask when the pricing experiments restart', who: null, done: false }, 'Now on pricing: the experiments wait for clean analytics.')"
        }
      ],
      "hold": 2100
    },
    {
      "id": "notes",
      "caption": "Full notes when it ends",
      "ready": ".home",
      "camera": ".page",
      "pad": 0,
      "cursorStart": "text:Record",
      "steps": [
        {
          "click": ".latest-title"
        },
        {
          "wait": 500
        },
        {
          "hover": "text:Summary"
        }
      ],
      "hold": 2100
    },
    {
      "id": "transcript",
      "caption": "Knows who said what",
      "ready": ".home",
      "setup": [
        {
          "click": ".latest-title"
        },
        {
          "wait": 500
        }
      ],
      "camera": ".page",
      "pad": 0,
      "cursorStart": "text:Summary",
      "steps": [
        {
          "click": "text:Transcript"
        }
      ],
      "hold": 2600
    },
    {
      "id": "stats",
      "caption": "See how the call went",
      "ready": ".home",
      "setup": [
        {
          "click": ".latest-title"
        },
        {
          "wait": 500
        }
      ],
      "camera": ".page",
      "pad": 0,
      "cursorStart": "text:Transcript",
      "steps": [
        {
          "click": "text:Stats"
        },
        {
          "wait": 600
        },
        {
          "scroll": ".timeline",
          "to": 175
        },
        {
          "hover": ".timeline-lane:nth-child(2) .timeline-span:nth-child(14)"
        }
      ],
      "hold": 2300
    },
    {
      "id": "dictate",
      "caption": "Speak instead of typing",
      "flags": "indicator",
      "ready": ".indicator-stage",
      "setup": [
        {
          "stage": "compose"
        },
        {
          "wait": 400
        }
      ],
      "camera": [
        120,
        40,
        760
      ],
      "cursorStart": ".stage-msg p",
      "steps": [
        {
          "click": ".stage-compose"
        },
        {
          "eval": "__stage.focus()"
        },
        {
          "wait": 350
        },
        {
          "cursor": "hide"
        },
        {
          "eval": "__stage.dictate(\"Sounds good, I'll send the rollout plan to support by Wednesday.\")"
        }
      ],
      "hold": 1500
    },
    {
      "id": "dictations",
      "caption": "See the time you save",
      "ready": ".home",
      "setup": [
        {
          "eval": "document.querySelector('.main-scroll').style.opacity = '0'"
        }
      ],
      "camera": [
        236,
        112,
        730
      ],
      "steps": [
        {
          "cursor": "hide"
        },
        {
          "eval": "(async () => { [...document.querySelectorAll('.sidebar .nav-item')].find((b) => b.textContent.trim() === 'Dictations').click(); await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r))); const m = document.querySelector('.main-scroll'); m.style.transition = 'opacity 250ms ease'; m.style.opacity = '1'; })()"
        },
        {
          "wait": 1200
        }
      ],
      "hold": 2300
    }
  ]
}
