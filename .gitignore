# Cargo build output
/target/

# Eval outputs and private meeting transcripts (never commit real meetings)
/eval/results/*
!/eval/results/.gitkeep
/eval/transcripts/private/

# Model files (normally in the app data dir; guard against stray copies)
ggml-*.bin
*.gguf
*.onnx

# Editor / OS clutter
.DS_Store
Thumbs.db
.idea/

# Generated benchmark audio (rebuild with eval/bench/make_bench_audio.sh)
/eval/bench/*.wav

# App frontend
/app/node_modules/
/app/dist/
/app/src-tauri/gen/
/eval/dictation/clips/
/eval/dictation/private/
/eval/diarization/data/

# Verified sherpa-onnx libraries (scripts/fetch-sherpa-onnx.sh)
/.sherpa-onnx/

# Release builds (.github/workflows/release.yml)
/dist-release/
/app/src-tauri/windows-libs/
/site/_site/
/site/video/out/
# The overview video: generated clips, voice and music, and the render
/site/overview/cache/
/site/overview/out/
/site/overview/remotion/node_modules/
